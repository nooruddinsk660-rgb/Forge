{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/anthropic", "destination": "/api/anthropic" },
    { "source": "/api/groq",      "destination": "/api/groq"      },
    { "source": "/api/openrouter","destination": "/api/openrouter" },
    { "source": "/(.*)",          "destination": "/index.html"    }
  ]
}
