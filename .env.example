# FORGE v4.0 Environment Variables Configuration
# Copy this file to '.env.local' or '.env' and fill in your API keys securely.
# Vite automatically pre-loads keys prefixed with 'VITE_' into client-side environment variables.

# Your Anthropic API Key (e.g. sk-ant-...)
VITE_ANTHROPIC_API_KEY=your_actual_anthropic_api_key_here

# Your Google Gemini API Key (e.g. AIzaSy...)
VITE_GEMINI_API_KEY=your_actual_gemini_api_key_here

# Your Groq API Key (e.g. gsk_...)
VITE_GROQ_API_KEY=your_actual_groq_api_key_here

# Your OpenRouter API Key (e.g. sk-or-v1-...)
VITE_OPENROUTER_API_KEY=your_actual_openrouter_api_key_here

