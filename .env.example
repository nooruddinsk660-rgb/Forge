# FORGE v4.0 Environment Variables
# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit real keys.

# ── Gemini (SERVER-SIDE only — no VITE_ prefix)
# Add this to: Vercel Dashboard → Settings → Environment Variables
# Name: GEMINI_API_KEY  |  Value: AIzaSy...
GEMINI_API_KEY=your_gemini_api_key_here

# ── BYOK Models (client-side convenience for local dev)
# On production Vercel, users paste these in the app UI.
# In .env.local, pre-filling them saves you time during development.
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
